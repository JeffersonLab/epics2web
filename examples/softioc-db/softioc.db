record(ao,"channel1") {
        field(DTYP,"Soft Channel")
        field(HHSV,MAJOR)
        field(HIHI,1)
}
record(ao,"channel2") {
        field(DTYP,"Soft Channel")
        field(HHSV,MAJOR)
        field(HIHI,1)
}
record(calc,"counter_HELLO") {
  field(SCAN, ".2 second")
  field(CALC, "(A+1)%17")
  field(INPA, "counter_HELLO.VAL")
  field(FLNK, "HELLO.PROC")
  field(VAL, "0")
}
record(calc,"HELLO") {
  field(SCAN, "Passive")
  field(CALC, "(A<=8)*(2**A)+(A>8)*(2**(17-A))")
  field(INPA, "counter_HELLO.VAL")
  field(VAL, "0")
}

# Strings of 15000 characters that change 10 times a second, so StalledClientTest can fill a
# client's TCP buffers in seconds
record(calc,"big_counter") {
  field(SCAN, ".1 second")
  field(CALC, "A+1")
  field(INPA, "big_counter")
  field(FLNK, "big_string_1")
}
record(printf,"big_string_1") {
  field(FMT, "%015000d")
  field(INP0, "big_counter")
  field(SIZV, "15001")
  field(FLNK, "big_string_2")
}
record(printf,"big_string_2") {
  field(FMT, "%015000d")
  field(INP0, "big_counter")
  field(SIZV, "15001")
  field(FLNK, "big_string_3")
}
