<%-- A client's label, set as "label": a link if the client named itself with a web address --%><c:choose><c:when test="${label.href ne null}"><a class="client-label" href="<c:out value="${label.href}"/>" title="<c:out value="${label.title}"/>"><c:out value="${label.text}"/></a></c:when><c:otherwise><span class="client-label" title="<c:out value="${label.title}"/>"><c:out value="${label.text}"/></span></c:otherwise></c:choose>
